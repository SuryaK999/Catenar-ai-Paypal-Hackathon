# Catenar.ai — Environment Configuration Contract
# PayPal AI Hackathon 2026

# Server Port & Runtime
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Neon Serverless PostgreSQL Database Connection (HTTP/WebSocket Pooler)
# Format: postgresql://<user>:<password>@<endpoint>.us-east-2.aws.neon.tech/catenar?sslmode=require
DATABASE_URL=postgresql://catenar_owner:sample_password@ep-catenar-pooler.us-east-2.aws.neon.tech/catenar?sslmode=require

# PayPal Developer Sandbox Credentials (@paypal/agent-toolkit)
PAYPAL_CLIENT_ID=A_SAMPLE_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=E_SAMPLE_PAYPAL_SANDBOX_CLIENT_SECRET
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_WEBHOOK_ID=SAMPLE_WEBHOOK_ID_FOR_VERIFICATION

# Channel3 E-Commerce API (100M+ Product Catalog)
CHANNEL3_API_KEY=
CHANNEL3_API_URL=https://api.channel3.ai/v1

# Render Deployment & Background Workflow Worker
RENDER_EXTERNAL_URL=https://catenar-ai.onrender.com
RENDER_SERVICE_ID=srv-catenar-web
